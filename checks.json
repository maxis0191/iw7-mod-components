    {
      "id": "voicecertify_analyzer_test",
      "command": [
        "python",
        "-I",
        "tests/voice-certify/test_analyze_voice.py",
        "-v"
      ],
      "reason": "Needs numpy and an installed en-US SAPI voice; faster-whisper is optional. These are not installed on the source CI runner. Run locally."
    },
    {
      "id": "voice_test_bytes",
      "command": [
        "python",
        "-I",
        "ops/voice-certify/check_voice_test_bytes.py",
        "src/native/voice_test.cpp",
        "<unpacked retail dump dir>"
      ],
      "reason": "Needs capstone and a local unpacked retail code dump (unpacked-text.bin), which never enters Git. Run locally."
    },
    {
      "id": "voice_engine_addresses",
      "command": [
        "python",
        "-I",
        "ops/voice-certify/verify_engine_addresses.py",
        "<iw7-mod checkout with the voice relay>",
        "<unpacked retail dump dir>"
      ],
      "reason": "Needs capstone, a native checkout carrying the relay and a local unpacked retail code dump (unpacked-text.bin, unpacked-pdata.bin). Run locally."
    }
  ]
