   "s": 3
  },
  {
   "do": "call",
   "fn": "r1_stock_hints",
   "args": [],
   "s": 6
  },
  {
   "do": "call",
   "fn": "r1_alive",
   "args": [],
   "s": 3
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "expect",
   "that": "probe:stock.done",
   "eq": 2,
   "why": "a perk machine key and a wall buy key set by script"
  },
  {
   "do": "expect",
   "that": "probe:after.alive",
   "eq": 1,
   "why": "the level still runs"
  }
 ]
